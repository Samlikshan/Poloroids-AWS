<link rel="stylesheet" href="/stylesheets/admin/users.css">

<div class="header">
    <h1>User Management</h1>
    <div class="search-container">
        <input type="text" class="search-input" placeholder="Search...">
    </div>
</div>
<table class="user-table">
    <thead>
        <tr>
            <th>User ID</th>
            <th>Username</th>
            <th>Email Address</th>
            <th>Status</th>
            <th>Change Status</th>
        </tr>
    </thead>
    <tbody>
        {{#each users}}
        <tr data-username="{{username}}" data-email="{{email}}">
            <td><a href="/admin/users/{{_id}}">{{_id}}</a></td>
            <td><a href="/admin/users/{{_id}}">{{username}}</a></td>
            <td><a href="mailto:{{email}}">{{email}}</a></td>
            {{!-- <td><a href="/admin/orders/{{_id}}">{{orderCount}}</a></td> --}}
            <td class="status-text">{{#if isActive}}Active{{else}}Inactive{{/if}}</td>
            <td>
                <button class="status-btn" data-id="{{_id}}" data-status="{{isActive}}">
                    {{#if isActive}}Deactivate{{else}}Activate{{/if}}
                </button>
            </td>
        </tr>
        {{/each}}
    </tbody>

</table>

<script src="/javascripts/admin/users.js"></script>