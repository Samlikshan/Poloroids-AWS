<link rel="stylesheet" href="/stylesheets/admin/categories.css">

<div class="header">
    <h1>Categories</h1>
</div>

<div class="categories-grid">
    <!-- BRAND -->
    <div class="category-card">
        <h2>Brand</h2>
        <ul>
            {{#each brand}}
            <li>
                <span class="category-name" id="category-name-{{this._id}}">{{this.categoryName}}</span>
                <button class="edit-btn"
                    onclick="editCategory('{{this._id}}', '{{this.categoryName}}', 'Brand')">Edit</button>
                <a href="#" class="status-link"
                    onclick="toggleStatus(event, '{{this._id}}', '{{this.isActive}}', 'Brand')">
                    {{#if this.isActive}}Deactivate{{else}}Activate{{/if}}
                </a>
            </li>
            {{/each}}
        </ul>
        <button class="add-item-btn" onclick="openModal('Brand')">+</button>
    </div>

    <!-- TYPE -->
    <div class="category-card">
        <h2>Type</h2>
        <ul>
            {{#each type}}
            <li>
                <span class="category-name" id="category-name-{{this._id}}">{{this.categoryName}}</span>
                <button class="edit-btn"
                    onclick="editCategory('{{this._id}}', '{{this.categoryName}}', 'Type')">Edit</button>
                <a href="#" class="status-link"
                    onclick="toggleStatus(event, '{{this._id}}', '{{this.isActive}}', 'Type')">
                    {{#if this.isActive}}Deactivate{{else}}Activate{{/if}}
                </a>
            </li>
            {{/each}}
        </ul>
        <button class="add-item-btn" onclick="openModal('Type')">+</button>
    </div>

    <!-- GEAR -->
    <div class="category-card">
        <h2>Gear</h2>
        <ul>
            {{#each gear}}
            <li>
                <span class="category-name" id="category-name-{{this._id}}">{{this.categoryName}}</span>
                <button class="edit-btn"
                    onclick="editCategory('{{this._id}}', '{{this.categoryName}}', 'Gear')">Edit</button>
                <a href="#" class="status-link"
                    onclick="toggleStatus(event, '{{this._id}}', '{{this.isActive}}', 'Gear')">
                    {{#if this.isActive}}Deactivate{{else}}Activate{{/if}}
                </a>
            </li>
            {{/each}}
        </ul>
        <button class="add-item-btn" onclick="openModal('Gear')">+</button>
    </div>
</div>

<!-- Add Category Modal -->
<div id="categoryModal" class="modal">
    <div class="modal-content">
        <span class="close-btn" onclick="closeModal()">&times;</span>
        <h2 id="modalTitle">Add Sub-Category</h2>
        <form id="categoryForm" onsubmit="saveCategories(event)">
            <input type="hidden" id="categoryType" name="categoryType">
            <div id="keyFields"></div>
            <button type="submit" class="save-btn">Save</button>
        </form>
    </div>
</div>

<!-- Edit Category Modal -->
<div id="editCategoryModal" class="modal">
    <div class="modal-content">
        <span class="close-btn" onclick="closeEditCategoryModal()">&times;</span>
        <h2>Edit Category</h2>
        <form id="editCategoryForm" onsubmit="updateCategory(event)">
            <input type="hidden" id="editCategoryId">
            <input type="hidden" id="editCategoryType">
            <div class="form-group">
                <input type="text" id="editCategoryName" placeholder="Enter category name" required>
            </div>
            <button type="submit" class="save-btn">Save</button>
        </form>
    </div>
</div>
<script>
    function findCategoryCard(type) {
        const cards = document.querySelectorAll('.category-card');
        for (const card of cards) {
            if (card.querySelector('h2')?.textContent.trim() === type) {
                return card;
            }
        }
    }

    function openModal(categoryType) {
        document.getElementById('modalTitle').textContent = 'Add Sub-Category to ' + categoryType;
        document.getElementById('categoryType').value = categoryType;
        document.getElementById('keyFields').innerHTML = '';
        addField();
        document.getElementById('categoryModal').style.display = 'block';
    }

    function addField(value = '') {
        const keyFields = document.getElementById('keyFields');
        const fieldDiv = document.createElement('div');
        fieldDiv.className = 'form-group';
        fieldDiv.innerHTML = `<input type="text" name="categoryName[]" value="${value}" placeholder="Enter value" required/>`;
        keyFields.appendChild(fieldDiv);
    }

    function closeModal() {
        document.getElementById('categoryModal').style.display = 'none';
    }

    function saveCategories(event) {
        event.preventDefault();
        const fields = document.querySelectorAll('input[name="categoryName[]"]');
        const categories = Array.from(fields).map(f => f.value.trim()).filter(Boolean);

        if (!categories.length) return toastr.warning('Please enter a category');
        if (new Set(categories).size !== categories.length) return toastr.warning('Duplicates not allowed');
        if (categories.some(c => !/^[A-Za-z\s]+$/.test(c))) return toastr.warning('Only letters allowed');

        const categoryType = document.getElementById('categoryType').value;

        fetch('/admin/add-category', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
                categoryType,
                categories: categories.map(name => ({ categoryName: name }))
            })
        }).then(res => res.json())
            .then(data => {
                if (data.message) return toastr.warning(data.message);
                closeModal();
                toastr.success('Added successfully');

                const container = findCategoryCard(categoryType);
                const ul = container.querySelector('ul');
                data.newCategories.forEach(cat => {
                    const li = document.createElement('li');
                    li.innerHTML = `
                      <span class="category-name" id="category-name-${cat._id}">${cat.categoryName}</span>
                      <button class="edit-btn" onclick="editCategory('${cat._id}', '${cat.categoryName}', '${categoryType}')">Edit</button>
                      <a href="#" class="status-link" onclick="toggleStatus(event, '${cat._id}', 'true', '${categoryType}')">Deactivate</a>
                  `;
                    ul.appendChild(li);
                });
            })
            .catch(err => toastr.error('Error saving category'));
    }

    function toggleStatus(event, id, isActive, categoryType) {
        event.preventDefault();
        const newStatus = isActive === 'true' ? false : true;

        fetch('/admin/toggle-status', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ id, status: newStatus, categoryType })
        }).then(res => res.json())
            .then(data => {
                if (data.success) {
                    const link = event.target;
                    link.textContent = newStatus ? 'Deactivate' : 'Activate';
                    link.setAttribute('onclick', `toggleStatus(event, '${id}', '${newStatus}', '${categoryType}')`);
                    toastr.success(`Status updated`);
                } else {
                    toastr.error(data.message || 'Could not toggle status');
                }
            })
            .catch(err => toastr.error('Toggle failed'));
    }

    function editCategory(id, currentName, categoryType) {
        document.getElementById('editCategoryId').value = id;
        document.getElementById('editCategoryName').value = currentName;
        document.getElementById('editCategoryType').value = categoryType;
        document.getElementById('editCategoryModal').style.display = 'block';
    }

    function closeEditCategoryModal() {
        document.getElementById('editCategoryModal').style.display = 'none';
    }

    function updateCategory(event) {
        event.preventDefault();
        const id = document.getElementById('editCategoryId').value;
        const name = document.getElementById('editCategoryName').value.trim();
        const type = document.getElementById('editCategoryType').value;

        if (!name || !/^[A-Za-z\s]+$/.test(name)) return toastr.warning('Invalid name');

        fetch('/admin/edit-category', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ id, categoryName: name, categoryType: type })
        }).then(res => res.json())
            .then(data => {
                if (data.message) return toastr.error(data.message);
                closeEditCategoryModal();
                toastr.success('Updated');
                document.getElementById(`category-name-${id}`).textContent = name;
            })
            .catch(err => toastr.error('Update failed'));
    }
</script>