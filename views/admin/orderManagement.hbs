<!-- orderManagement.handlebars -->
<link rel="stylesheet" href="/stylesheets/admin/orderManagement.css">

<div class="header">
    <h1>Order Management</h1>
</div>

<table class="order-table">
    <thead>
        <tr>
            <th>Order ID</th>
            <th>User Name</th>
            <th>Date</th>
            <th>Amount</th>
            <th>Status</th>
        </tr>
    </thead>
    <tbody>
        {{#each orders}}
        {{#each items}}
        <tr>
            <td><a href="/admin/order/{{../_id}}/{{_id}}">{{../_id}}</a></td>
            <td><a href="/admin/order/{{../_id}}/{{_id}}">{{../address.firstName}}</a></td>
            <td>{{formatDate ../createdAt}}</td>
            <td><a href="/admin/order/{{../_id}}/{{_id}}">{{totalPrice}}</a></td>
            <td>
                <div class="status-container">
                    <button class="status-btn {{status}}">{{status}}</button>
                    {{#unless (eq orderStatus "canceled")}}
                    <div class="status-options">
                        <a data-status="pending" data-order-id="{{../_id}}" data-user-id="{{userId}}"
                            data-order-itemId="{{_id}}">Pending</a>

                        <a data-status="delivered" data-order-id="{{../_id}}" data-user-id="{{userId}}"
                            data-order-itemId="{{_id}}">Delivered</a>
                    </div>
                    {{/unless}}
                </div>
            </td>
        </tr>
        {{/each}}
        {{/each}}
    </tbody>
</table>

<script src="/javascripts/admin/orderManagement.js"></script>