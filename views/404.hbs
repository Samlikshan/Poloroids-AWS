<!-- views/404.hbs -->
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <title>404 - Page Not Found</title>
    <style>
        body {
            font-family: 'Segoe UI', sans-serif;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            height: 100vh;
            margin: 0;
            background-color: #f8f9fa;
            color: #333;
        }

        h1 {
            font-size: 5rem;
            margin-bottom: 0;
        }

        p {
            font-size: 1.5rem;
        }

        a {
            margin-top: 20px;
            display: inline-block;
            text-decoration: none;
            padding: 10px 20px;
            background: #ff380b;
            color: white;
            border-radius: 5px;
        }

        a:hover {
            background: #ff380b;
        }
    </style>
</head>

<body>
    <h1>404</h1>
    <p>Oops! Page not found.</p>
    <a href="/">Go to Home</a>
</body>

</html>